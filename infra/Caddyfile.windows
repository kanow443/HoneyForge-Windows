{
    auto_https disable_redirects
}
http://localhost {
    redir https://localhost:8443{uri} permanent
}
localhost {
    tls internal
    encode zstd gzip
    @backend path /api/* /integration/* /health/*
    handle @backend {
        reverse_proxy api:8100 {
            flush_interval -1
        }
    }
    @hidden path /agent/* /docs /redoc /openapi.json
    handle @hidden {
        respond "Not found" 404
    }
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
        header {
            X-Content-Type-Options nosniff
            Referrer-Policy same-origin
            Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'"
        }
    }
}
