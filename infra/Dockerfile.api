FROM ghcr.io/astral-sh/uv:0.12.19@sha256:04d046b13e60d6bcec73cbc5e1cad25d680dea90c8573340950a0ac2d1aef424 AS uv
FROM python:3.12-slim@sha256:a6e34c598f2467ed0e9a8d349809fcd8b5c603269512df273a0bb1784edc11b1
COPY --from=uv /uv /uvx /usr/local/bin/
WORKDIR /app
COPY pyproject.toml uv.lock alembic.ini ./
COPY src ./src
COPY infra/migrations ./infra/migrations
COPY infra/start-api.sh ./infra/start-api.sh
RUN uv sync --frozen --no-dev --no-editable && chmod 755 /app/infra/start-api.sh && \
    mkdir -p /var/lib/honeyforge/evidence /var/lib/asset-ca && chown -R 10001:10001 /var/lib/honeyforge /var/lib/asset-ca
ENV PATH="/app/.venv/bin:$PATH" HF_BIND=0.0.0.0 HF_ARTIFACT_DIR=/var/lib/honeyforge/evidence
USER 10001:10001
ENTRYPOINT ["/app/infra/start-api.sh"]
