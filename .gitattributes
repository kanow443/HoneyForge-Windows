*.pdf binary
*.pptx binary
*.png binary
*.jpg binary
*.webp binary
*.webm binary
*.mmdb binary
# Keep genuine exported CRLF CSV and raw test logs byte-for-byte.
docs/evidence/** whitespace=-blank-at-eof,cr-at-eol
# Windows launchers preserve CRLF; Bash entry points preserve LF.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.sh text eol=lf
data/geo/*.mmdb filter=lfs diff=lfs merge=lfs -text
